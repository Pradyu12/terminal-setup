#!/usr/bin/env bash
# Black Pearl workspace: 3-pane tmux layout
#   TL: "THE BLACK PEARL" text (read-only)         R: btop (graphs)
#   BL: Ubuntu logo + usable shell (wireshark, etc.)

SESSION="pearl"

# If session exists, attach and bail
if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach-session -t "$SESSION"
fi

tmux new-session -d -s "$SESSION" -c "$HOME" 'bash --norc --noprofile ~/.local/bin/pearl-text.sh'
tmux rename-window -t "$SESSION" pearl
TL=$(tmux display -p '#{pane_id}')

# right pane at 60% so btop gets >=80 cols (its minimum)
tmux split-window -h -p 60 -t "$TL" 'btop || sleep 999'
BTOP=$(tmux display -p '#{pane_id}')

tmux select-pane -t "$TL"
tmux split-window -v -p 40 -t "$TL" 'bash --norc --noprofile ~/.local/bin/pearl-ubuntu.sh'
SHELL=$(tmux display -p '#{pane_id}')

tmux set-option -t "$SESSION" status on

# Focus the shell pane (bottom-left)
tmux select-pane -t "$SHELL"

exec tmux attach-session -t "$SESSION"
