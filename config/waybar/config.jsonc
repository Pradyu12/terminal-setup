{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 8,
    "margin-right": 8,
    "margin-top": 4,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "disk", "network", "pulseaudio", "tray"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace +1",
        "on-scroll-down": "hyprctl dispatch workspace -1",
        "all-outputs": true,
        "active-only": false
    },

    "clock": {
        "format": " {:%I:%M %p}",
        "format-alt": " {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "interval": 1
    },

    "cpu": {
        "interval": 1,
        "format": " {usage}%",
        "tooltip-format": "{avg_frequency} GHz",
        "max-length": 10
    },

    "memory": {
        "interval": 3,
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f} GB / {total:0.1f} GB",
        "max-length": 10
    },

    "disk": {
        "interval": 30,
        "format": " {percentage_used}%",
        "tooltip-format": "{used} / {total}",
        "max-length": 10
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": " Offline",
        "tooltip-format": "{ipaddr}/{cidr}",
        "max-length": 15
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " Muted",
        "on-click": "pavucontrol",
        "max-length": 10
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
